# ===== GOOGLE OAUTH CONFIGURATION =====
# Get your Google Client ID from: https://console.cloud.google.com/
# 1. Create a new project or select existing one
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URIs: http://localhost:3000, https://yourdomain.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# ===== SECURITY =====
# JWT Secret for token signing (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters

# Session secret for additional security
SESSION_SECRET=another-super-secret-key-for-sessions

# ===== SERVER CONFIGURATION =====
# Server port
PORT=3000

# Node environment
NODE_ENV=development

# CORS origin (use your domain in production)
CORS_ORIGIN=http://localhost:3000

# ===== DATABASE =====
# SQLite database file path
DATABASE_URL=./social.db

# Database connection pool settings
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=30000

# ===== FILE UPLOAD =====
# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/mov,video/avi

# Upload directory
UPLOAD_DIR=./uploads

# ===== EMAIL CONFIGURATION ===== (Optional - for future features)
# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===== EXTERNAL APIs ===== (Optional)
# For image optimization, maps, etc.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# MAPBOX_ACCESS_TOKEN=your-mapbox-token

# ===== RATE LIMITING =====
# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== LOGGING =====
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/app.log

# ===== CACHE =====
# Redis URL for caching (optional)
# REDIS_URL=redis://localhost:6379

# Cache TTL in seconds
CACHE_TTL=3600

# ===== MONITORING ===== (Optional)
# Application monitoring
# SENTRY_DSN=your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# ===== PRODUCTION SETTINGS =====
# Use HTTPS in production
FORCE_HTTPS=false

# Trusted proxy settings
TRUST_PROXY=1

# Compression level
COMPRESSION_LEVEL=6
